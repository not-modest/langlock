{
  "manifest_version": 3,
  "name": "Langlock",
  "version": "1.0.2",
  "minimum_chrome_version": "101",
  "description": "Keep the Google Scholar interface in your selected language.",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://scholar.google.com/*",
    "*://scholar.google.ca/*",
    "*://scholar.google.co.in/*",
    "*://scholar.google.co.jp/*",
    "*://scholar.google.co.kr/*",
    "*://scholar.google.co.uk/*",
    "*://scholar.google.com.au/*",
    "*://scholar.google.com.br/*",
    "*://scholar.google.com.hk/*",
    "*://scholar.google.com.tw/*",
    "*://scholar.google.de/*",
    "*://scholar.google.es/*",
    "*://scholar.google.fr/*",
    "*://scholar.google.it/*",
    "*://scholar.google.nl/*",
    "*://scholar.google.pl/*"
  ],
  "action": {
    "default_title": "Langlock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "english_default",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
